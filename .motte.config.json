{
  "$schema": "https://codevachon.github.io/motte/schema/config.json",
  "name": "family-chat-cli",
  "issuesDir": ".motte/issues",
  "defaultState": "Todo",
  "states": [
    {
      "name": "Todo",
      "category": "unstarted"
    },
    {
      "name": "In Progress",
      "category": "started"
    },
    {
      "name": "Done",
      "category": "completed"
    }
  ]
}
